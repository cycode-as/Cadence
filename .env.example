# CADENCE Database & Local Seeding Configuration
# Copy this file to .env and fill in your local PostgreSQL credentials.
# Never commit .env to Git.

# PostgreSQL connection string (Psycopg 3 driver recommended; postgresql:// is auto-normalized)
DATABASE_URL=postgresql+psycopg://cadence_user:REPLACE_WITH_PASSWORD@localhost:5432/cadence_db

# Optional SQLAlchemy engine settings
DB_ECHO=false
DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Local-only seed demo password (used by: python -m database.seed)
# Set a local password here when running the seed script in development.
CADENCE_SEED_PASSWORD=REPLACE_WITH_LOCAL_DEMO_PASSWORD
APP_ENV=development
